MCP_PORT=3010
LOG_LEVEL=info

# ─── Admin Web UI (Port 3011) ─────────────────────────────────────────────────
# Port for the Admin Web UI (token manager, audit logs, local QR pairing).
# Set to 0 or "disabled" to turn off the Admin UI completely.
MCP_ADMIN_PORT=3011
# Required to enable the Admin UI. Generate a strong password!
MCP_ADMIN_PASSWORD=

# ─── MCP Endpoint Auth (/sse) ─────────────────────────────────────────────────
# /sse is fail-closed by default. Create scoped per-agent tokens in the Admin UI.
# Optional legacy full-access token (kept for backwards compatibility with existing clients):
MCP_AUTH_TOKEN=
# Set to "true" to hard-disable MCP_AUTH_TOKEN even if still set in env:
# MCP_DISABLE_LEGACY_TOKEN=false
# Per-IP rate limit on /sse (requests per minute):
MCP_RATE_LIMIT_PER_MIN=120
# ONLY for isolated localhost-only setups without any tokens (NOT recommended):
# MCP_ALLOW_UNAUTHENTICATED=false

# Timezone for human-readable timestamps in MCP responses.
TZ=Europe/Berlin

# Verbose @lid resolution logs to stdout (very noisy).
# WHATSAPP_DEBUG=true

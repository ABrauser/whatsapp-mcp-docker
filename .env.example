MCP_PORT=3010
LOG_LEVEL=info

# Bearer token required by clients in `Authorization: Bearer <token>`.
# Generate a strong one, e.g.: `openssl rand -hex 32`.
# If unset, /sse is OPEN — only acceptable on localhost-only deployments.
MCP_AUTH_TOKEN=

# Timezone for human-readable timestamps in MCP responses.
TZ=Europe/Berlin

# Verbose @lid resolution logs to stdout (very noisy).
# WHATSAPP_DEBUG=true
